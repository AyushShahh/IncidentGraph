# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
DEPLOYMENT_VERSION=v1.0.0

# Service Ports
GATEWAY_PORT=8001
ORDERS_PORT=8002
PAYMENTS_PORT=8003
INVENTORY_PORT=8004
NOTIFICATIONS_PORT=8005
BACKEND_PORT=8000

# Inter-Service Communication URLs (Docker Network)
ORDERS_SERVICE_URL=http://orders:8002
PAYMENTS_SERVICE_URL=http://payments:8003
INVENTORY_SERVICE_URL=http://inventory:8004
NOTIFICATIONS_SERVICE_URL=http://notifications:8005

# PostgreSQL Configuration
POSTGRES_VERSION=18
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis Configuration
REDIS_VERSION=latest
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Apache Kafka Configuration
KAFKA_VERSION=latest
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_LOGS_TOPIC=service-logs
KAFKA_CONSUMER_GROUP=incident-processor-group

# Qdrant Vector DB Configuration
QDRANT_VERSION=latest
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# PyTorch & CUDA Settings (Configured for future platform stages)
TARGET_DEVICE=cu132
GPU_DRIVER=nvidia
GPU_COUNT=all

# Celery & Queue Settings
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# Stage 2: Batch Clustering & Consumer Settings
KAFKA_BATCH_SIZE=500
KAFKA_BATCH_INTERVAL_SECONDS=10.0
MONITORED_LOG_LEVELS=ERROR,WARNING

# Stage 2: Deduplication & Similarity Settings
SIMILARITY_THRESHOLD=0.85
REDIS_FINGERPRINT_TTL_SECONDS=172800

# Stage 2: Pluggable Embeddings Settings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Stage 2: HDBSCAN Clustering Settings
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=1
HDBSCAN_MAX_CLUSTER_DISTANCE=0.85
HDBSCAN_CLUSTER_SELECTION_EPSILON=0.0
