# ==============================================================================
# AI Incident Intelligence Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your local or production environment.
# Sensitive API keys, passwords, and tokens should NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Application Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Incident Intelligence Platform"
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEBUG=True                             # Set to False in production
DEPLOYMENT_VERSION=v1.0.0

# ------------------------------------------------------------------------------
# 2. Service Ports & Network Bindings
# ------------------------------------------------------------------------------
GATEWAY_PORT=8001
ORDERS_PORT=8002
PAYMENTS_PORT=8003
INVENTORY_PORT=8004
NOTIFICATIONS_PORT=8005
BACKEND_PORT=8000
FRONTEND_PORT=3000


# ------------------------------------------------------------------------------
# 3. Inter-Service Communication URLs (Docker Network vs Localhost)
# ------------------------------------------------------------------------------
ORDERS_SERVICE_URL=http://orders:8002
PAYMENTS_SERVICE_URL=http://payments:8003
INVENTORY_SERVICE_URL=http://inventory:8004
NOTIFICATIONS_SERVICE_URL=http://notifications:8005
GATEWAY_URL=http://gateway:8001
BACKEND_URL=http://backend:8000

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_VERSION=18
POSTGRES_HOST=postgres                 # Use 'localhost' when running backend outside Docker
POSTGRES_PORT=5432
POSTGRES_DB=incident_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Direct database URL override (optional - auto-assembled if omitted):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/incident_db

# ------------------------------------------------------------------------------
# 5. Redis Cache & Broker Configuration
# ------------------------------------------------------------------------------
REDIS_VERSION=latest
REDIS_HOST=redis                       # Use 'localhost' when running backend outside Docker
REDIS_PORT=6379
REDIS_PASSWORD=                        # Set if Redis requires AUTH
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. Apache Kafka Configuration
# ------------------------------------------------------------------------------
KAFKA_VERSION=latest
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092    # Use 'localhost:9092' for external clients
KAFKA_LOGS_TOPIC=service-logs
KAFKA_INCIDENTS_TOPIC=incident-events
KAFKA_CONSUMER_GROUP=incident-processor-group

# ------------------------------------------------------------------------------
# 7. Qdrant Vector Database Configuration
# ------------------------------------------------------------------------------
QDRANT_VERSION=latest
QDRANT_HOST=qdrant                     # Use 'localhost' when running backend outside Docker
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=                            # Optional: Full URL for Qdrant Cloud (e.g. https://xyz.cloud.qdrant.io:6333)
QDRANT_API_KEY=                        # Optional: API key for secured Qdrant instances

# ------------------------------------------------------------------------------
# 8. Celery & Asynchronous Task Queue Settings
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 9. Hardware & Acceleration Settings (PyTorch & CUDA)
# ------------------------------------------------------------------------------
TARGET_DEVICE=cpu                      # 'cpu' or 'cu132' for NVIDIA CUDA 13.2 / PyTorch
GPU_DRIVER=nvidia
GPU_COUNT=all

# ------------------------------------------------------------------------------
# 10. Stage 2: Ingestion, Batch Clustering & HDBSCAN Settings
# ------------------------------------------------------------------------------
KAFKA_BATCH_SIZE=500
KAFKA_BATCH_INTERVAL_SECONDS=10.0
MONITORED_LOG_LEVELS=ERROR,WARNING
SIMILARITY_THRESHOLD=0.85
REDIS_FINGERPRINT_TTL_SECONDS=172800   # 48 hours fingerprint cache
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=1
HDBSCAN_CLUSTER_SELECTION_EPSILON=0.0
HDBSCAN_MAX_CLUSTER_DISTANCE=0.85

# ------------------------------------------------------------------------------
# 11. Stage 2: Pluggable Embeddings Settings
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers # sentence-transformers | gemini | ollama
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Google Gemini Embedding (Required if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Ollama Embedding (Required if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 12. Stage 3: Repository Intelligence & Context Engine Settings
# ------------------------------------------------------------------------------
REPOSITORIES_ROOT_DIR=services
MANIFESTS_STORAGE_DIR=backend/data/manifests
STAGE3_CODE_CHUNK_LINES=80
STAGE3_MAX_CONTEXT_TOKENS=3500

# ------------------------------------------------------------------------------
# 13. Stage 4: Pluggable LLM Providers & Inference API Keys
# ------------------------------------------------------------------------------
# Active LLM Provider: openai | anthropic | gemini | groq | ollama | vllm | llamacpp | mock
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite

# OpenAI API Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude Settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini / Vertex AI Settings
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_USE_VERTEX_AI=true             # Set to true to use Google GenAI SDK with Vertex AI, or false for direct HTTP Gemini Developer API
GOOGLE_CLOUD_PROJECT=                  # GCP Project ID (used when GEMINI_USE_VERTEX_AI=true)
GOOGLE_CLOUD_LOCATION=global      # GCP Region (e.g., global)

# Groq Cloud Fast Inference Settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama LLM Settings
OLLAMA_LLM_MODEL=qwen2.5-coder:latest

# Self-Hosted vLLM Server Settings
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Self-Hosted llama.cpp Server Settings
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=default

# ------------------------------------------------------------------------------
# 14. Stage 4: Investigation Loop Limits & Memory Thresholds
# ------------------------------------------------------------------------------
STAGE4_MAX_ITERATIONS=5                # Max tool iteration loops before forcing Reviewer audit
STAGE4_CONFIDENCE_THRESHOLD=0.85       # Minimum confidence to exit loop early
STAGE4_TOKEN_BUDGET=16000               # Global prompt/context token ceiling
STAGE4_TOOL_TIMEOUT_SECONDS=60.0       # Timeout per repository tool execution
STAGE4_MEMORY_SIMILARITY_THRESHOLD=0.80 # Cosine cutoff for Layer 2 instant solution cache hit
STAGE4_EXECUTION_MEMORY_TTL_SECONDS=86400 # 24 hours execution checkpoint TTL in Redis
