# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
DEPLOYMENT_VERSION=v1.0.0

# Service Ports
GATEWAY_PORT=8001
ORDERS_PORT=8002
PAYMENTS_PORT=8003
INVENTORY_PORT=8004
NOTIFICATIONS_PORT=8005
BACKEND_PORT=8000

# Inter-Service Communication URLs (Docker Network)
ORDERS_SERVICE_URL=http://orders:8002
PAYMENTS_SERVICE_URL=http://payments:8003
INVENTORY_SERVICE_URL=http://inventory:8004
NOTIFICATIONS_SERVICE_URL=http://notifications:8005

# PostgreSQL Configuration
POSTGRES_VERSION=18
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis Configuration
REDIS_VERSION=latest
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Apache Kafka Configuration
KAFKA_VERSION=latest
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_LOGS_TOPIC=service-logs
KAFKA_CONSUMER_GROUP=incident-processor-group

# Qdrant Vector DB Configuration
QDRANT_VERSION=latest
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# PyTorch & CUDA Settings (Configured for future platform stages)
TARGET_DEVICE=cu132
GPU_DRIVER=nvidia
GPU_COUNT=all
